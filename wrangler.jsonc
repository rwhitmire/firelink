// Cloudflare Workers config for the website: serve site/ as static files
// (index.html, the install bootstrap, and _headers). No code, no build step.
{
  "name": "firelink",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site"
  },
  // Deploying attaches firelink.estuslabs.com and creates its DNS record
  "routes": [
    { "pattern": "firelink.estuslabs.com", "custom_domain": true }
  ]
}
