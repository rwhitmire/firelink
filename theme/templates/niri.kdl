// {{name}} — generated by theme-set; edit theme/templates/niri.kdl in Firelink instead.
layout {
    focus-ring {
        active-color "#{{lavender}}"
        inactive-color "#{{surface1}}"
    }
    border {
        active-color "#{{lavender}}"
        inactive-color "#{{surface1}}"
        urgent-color "#{{red}}"
    }
}
