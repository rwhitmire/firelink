# Firelink's mako defaults, included by ~/.config/mako/config. Colors come from
# ~/.config/mako/theme, generated by theme-set.

font=Adwaita Sans 11
width=360
margin=12
padding=12,16
border-size=1
border-radius=12
icon-path=/usr/share/icons/Adwaita
max-icon-size=32
default-timeout=6000
layer=overlay
anchor=top-right

include=~/.config/mako/theme

[urgency=critical]
default-timeout=0

# Do not disturb (bin/dnd, Mod+Ctrl+N) hides notifications until it's turned off,
# then they show. Critical ones (low battery) still come through.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
