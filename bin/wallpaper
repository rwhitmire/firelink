#!/usr/bin/env bash
# Draw the background on every output (run by firelink-swaybg.service).
# theme-set points $state/wallpaper at the flavor's image, or removes it when the
# image isn't downloaded; then the flavor's base color is used instead.

state=${XDG_STATE_HOME:-$HOME/.local/state}/firelink

if [ -e "$state/wallpaper" ]; then
    exec swaybg -m fill -i "$state/wallpaper"
fi
exec swaybg -c "$(cat "$state/background" 2>/dev/null || echo '#1e1e2e')"
