#!/usr/bin/env bash
# Capture a screenshot and open it in Satty for annotation.
# Opened by Print (region), Ctrl+Print (monitor), Alt+Print (window) and the
# Firelink menu.
# Usage: screenshot [region|output|window]
#   region  select an area with slurp (default)
#   output  capture the focused monitor
#   window  capture the focused window
# In Satty: Enter copies to the clipboard and saves to ~/Pictures/Screenshots.

set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

mode=${1:-region}
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"

case "$mode" in
  region)
    geom=$(slurp -d) || exit 0 # Esc cancels
    capture=(grim -g "$geom" -)
    ;;
  output)
    output=$(niri msg -j focused-output | jq -r .name)
    capture=(grim -o "$output" -)
    ;;
  window)
    # Only niri knows where a window is (and can capture it when covered).
    # It writes the file after the command returns, so wait until it's whole.
    tmp=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/screenshot-XXXXXX.png")
    trap 'rm -f "$tmp"' EXIT
    niri msg action screenshot-window --path "$tmp"
    size=-1
    for _ in $(seq 50); do
      sleep 0.05
      new=$(stat -c %s "$tmp" 2>/dev/null) || continue
      [ "$new" -gt 0 ] && [ "$new" = "$size" ] && break
      size=$new
    done
    [ -s "$tmp" ] || exit 1
    capture=(cat "$tmp")
    ;;
  *)
    echo "usage: screenshot [region|output|window]" >&2
    exit 1
    ;;
esac

"${capture[@]}" | satty --filename - \
  --output-filename "$dir/Screenshot from %Y-%m-%d %H-%M-%S.png" \
  --copy-command wl-copy \
  --early-exit \
  --actions-on-enter save-to-clipboard \
  --save-after-copy
